
 # Ansible — Setup Docker Container for Nginx
 - name: Setup Docker Container for Nginx
   hosts: all
   become: yes
   tasks: 
    - name: Pull Nginx image
      docker_image:
        name: Nginx
        source: pull 
    - name: Run Nginx container
      docker_container:
         name: nginx-container
         image: Nginx
         state: started
         published_ports:
           - "8080:80"



  #   Terraform - EC2 with Auto Scaling      

   resource "aws_launch_configuration" "pathnexasg_lt" {
    name = "pathnexasg_lt"
    image_id = "ami-0abcd1234abcd1234"
    instance_type = "t3.medium"
    }    

   resource "aws_autoscaling_group" "pathnex_asg" {
    desired_capacity     = 2 
    max_size             = 3
    min_size             = 1
    vpc_zone_identifier  = ["subnet-1234567"]
    launch_configuration = aws_launch_configuration.pathnexasg_lt.id
    }




    # Kubernetes - Horizontal Pod Autoscaler (HPA)

    apiVersion: apps/v1
    kind: Deployment
    metadata:
      name: pathnex-
    spec: 
      replicas: 1
      selector:
        matchLabels:
           app: pathnex-app
      template:
        metadata:
           labels:
            app: pathnex-app
        spec:
          containers:
            - name: nginx
              image: nginx
              ports:
                 - containerPort: 80

   apiVersion: autoscaling/v1
   kind: HorizontalPodAutoscaler
   metadata:
     name: pathnex-hpa
   spec: 
     scaleTargetRef:
        apiVersion: apps/v1
        kind: Deployment
        name: pathnex-deployment
     minReplicas: 1
     maxReplicas: 10         
     targetCPUUtilizationPercentage: 50


     # Deploy to Kubernetes

     pipeline {
          agent any 
          stages {
              stage('Deploy to Kubernetes') {
                 steps {
                   script {
                      sh 'kubectl apply -f deployment.yaml'
                    }
                }
            }
         }
     }


     # Docker(Env. Var)

     FROM ubuntu:22.04
     ENV INSTITUTE=pathnex
     ENV COURSE=DevOps
     CMD echo "$INSTITUTE - $COURSE"
